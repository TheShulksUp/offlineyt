KEYWORD_MIN_LEN = 4
KEYWORD_TOPN = 15


def now_utc():
    return datetime.datetime.now(datetime.timezone.utc)


def parse_dt(raw):
    if raw is None:
        return None
    if isinstance(raw, (int, float)):
        stamp = float(raw)
        if stamp > 10_000_000_000:
            stamp /= 1000.0
        return datetime.datetime.fromtimestamp(stamp, tz=datetime.timezone.utc)
    s = str(raw).strip()
    if s.isdigit():
        return parse_dt(int(s))
    try:
        return datetime.datetime.fromisoformat(s)
    except ValueError:
        pass
    if s.endswith("Z") or s.endswith("z"):
        base = s[:-1]
        if re.search(r"[+-]\d\d:\d\d$", base):
            candidate = base
        else:
            candidate = base + "+00:00"
        try:
            return datetime.datetime.fromisoformat(candidate)
        except ValueError:
            pass
    return None


def extract_video_id(url):
    if not url:
        return None
    m = re.search(r"[?&]v=([A-Za-z0-9_-]{11})", url)
    if m:
        return m.group(1)
    m = re.search(r"/shorts/([A-Za-z0-9_-]{11})", url)
    if m:
        return m.group(1)
    m = re.search(r"/embed/([A-Za-z0-9_-]{11})", url)
    if m:
        return m.group(1)
    return None


def clean_title(raw):
    if not raw:
        return None
    t = raw
    for prefix in ("Watched ", "Watched a video ", "Watched a TV episode ",
                   "Watched a movie ", "Watched a "):
        if t.startswith(prefix):
            t = t[len(prefix):]
            break
    t = t.split(" - ")[0]
    t = t.strip()
    return t or None


def channel_url_ok(url):
    if not url:
        return None
    if "/channel/UC" in url:
        return url
    m = re.search(r"youtube\.com/(@[A-Za-z0-9._-]+)", url)
    if m:
        return "https://www.youtube.com/" + m.group(1)
    return None


def log(msg, silent=False, logfile=None):
    line = "[%s] %s" % (datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"), msg)
    if not silent:
        print(line, flush=True)
    if logfile:
        try:
            with open(logfile, "a") as fh:
                fh.write(line + "\n")
        except OSError:
            pass


def acquire_lock():
    lock_dir = os.path.expanduser("~/.config/yosync")
    fd = None
    try:
        os.makedirs(lock_dir, exist_ok=True)
        fd = open(os.path.join(lock_dir, ".lock"), "w")
        if fcntl:
            fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        pass
    return fd



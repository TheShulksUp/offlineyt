def load_config(silent=False):
    if not os.path.exists(CONFIG_PATH):
        return None
    try:
        with open(CONFIG_PATH) as fh:
            cfg = json.load(fh)
        cfg["dest"] = os.path.expanduser(cfg["dest"])
        # Fill in anything added since this config was written, so an existing
        # config picks up new settings (daemon_time, ...) instead of silently
        # missing them until the next save.
        for key, value in default_config(cfg["dest"]).items():
            cfg.setdefault(key, value)
        return cfg
    except (OSError, ValueError):
        log("config unreadable; run setup again", silent)
        return None


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_PATH, "w") as fh:
        json.dump(cfg, fh, indent=2)



function collect(){
 const out={};
 SCHEMA.forEach(g=>g.fields.forEach(f=>{
  const el=document.getElementById('f_'+f.key);if(!el)return;
  if(f.type==='bool')out[f.key]=el.checked;
  else if(f.type==='list')out[f.key]=el.value.split('\n').map(s=>s.trim()).filter(Boolean);
   else if(f.type==='map'){const m={};el.value.split('\n').forEach(ln=>{if(ln.includes('=')){const[k,v]=ln.split(/=(.*)/s).map(s=>s.trim());const n=parseFloat(v);if(k&&!isNaN(n))m[k]=n}});out[f.key]=m;}
   else if(f.type==='tiers'){const a=[];el.value.split('\n').forEach(ln=>{const p=ln.split(/[,\s]+/).filter(Boolean);if(p.length>=2){const w=parseFloat(p[0]),g=parseFloat(p[1]);if(!isNaN(w)&&!isNaN(g))a.push({min_watches:w,gb:g})}});out[f.key]=a;}
  else if(f.type==='number'){const n=parseFloat(el.value);out[f.key]=isNaN(n)?0:n;}
  else out[f.key]=el.value;
 }));return out;
}

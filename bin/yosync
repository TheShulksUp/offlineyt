SELL = {}


def _field(key):
    for g in SETTINGS_SCHEMA:
        for f in g["fields"]:
            if f["key"] == key:
                return f
    return None


def _base_cfg(cfg):
    return default_config(cfg.get("dest") or DEFAULT_DEST)


def _audio_only_names(cfg):
    return {str(n).strip().lower() for n in (cfg.get("audio_only_channels") or []) if str(n).strip()}


def _is_audio_channel(cfg, ch):
    names = _audio_only_names(cfg)
    if not names:
        return False
    return (ch.get("name") or "").lower() in names or \
           (ch.get("key") or "").lower() in names or \
           (ch.get("url") or "").lower() in names


def _coerce_val(ft, value):
    t = ft.get("type")
    if t == "text":
        return "" if value is None else str(value)
    if t == "number":
        try:
            fl = float(value)
        except (TypeError, ValueError):
            fl = 0.0
        lo, hi = ft.get("min"), ft.get("max")
        if lo is not None and fl < float(lo):
            fl = float(lo)
        if hi is not None and fl > float(hi):
            fl = float(hi)
        # Counts must stay ints: saving settings turned enrich_limit 150 into
        # 150.0, and missing[:150.0] throws TypeError on the next sync (this
        # killed every run, including --dry-run). Fractional values like the
        # 0.17 budget keep their float.
        return int(fl) if fl.is_integer() else fl
    if t == "bool":
        if isinstance(value, bool):
            return value
        return str(value).strip().lower() in ("1", "true", "yes", "on")
    if t == "list":
        if isinstance(value, str):
            value = [ln.strip() for ln in value.splitlines() if ln.strip()]
        return [str(v).strip() for v in (value or []) if str(v).strip()]
    if t == "map":
        out = {}
        if isinstance(value, dict):
            items = value.items()
        elif isinstance(value, str):
            items = ([ln.split("=", 1) for ln in value.splitlines() if "=" in ln])
        else:
            items = []
        for k, v in items:
            try:
                out[str(k).strip()] = float(v)
            except (TypeError, ValueError):
                continue
        return out
    if t == "tiers":
        out = []
        if isinstance(value, str):
            rows = [ln for ln in value.splitlines() if ln.strip()]
        else:
            rows = []
            for row in (value or []):
                if isinstance(row, dict):
                    rows.append("%s, %s" % (row.get("min_watches"), row.get("gb")))
                else:
                    rows.append(str(row))
        for ln in rows:
            if "," in ln:
                mw, gb = ln.split(",", 1)
            else:
                parts = ln.split()
                if len(parts) < 2:
                    continue
                mw, gb = parts[0], parts[1]
            try:
                out.append({"min_watches": int(float(mw.strip())),
                            "gb": float(gb.strip())})
            except (TypeError, ValueError):
                continue
        out.sort(key=lambda t: t["min_watches"])
        return out
    return value


def _schema_with_values(cfg):
    base = _base_cfg(cfg)
    groups = copy.deepcopy(SETTINGS_SCHEMA)
    for g in groups:
        for f in g["fields"]:
            f["value"] = cfg.get(f["key"], base.get(f["key"]))
    return groups


def _apply_config_update(cfg, payload):
    errors = []
    merged = dict(cfg)
    if not isinstance(payload, dict):
        return merged, ["request body must be a JSON object"]
    for key, value in payload.items():
        ft = _field(key)
        if ft is None:
            errors.append("unknown key: " + key)
            continue
        coerced = _coerce_val(ft, value)
        if ft.get("type") == "text" and key == "dest" and not str(coerced).strip():
            errors.append("library folder cannot be empty")
            continue
        if key == "daemon_time" and parse_daemon_time(coerced) is None:
            errors.append("daemon time must be HH:MM, 24-hour (e.g. 06:00, 23:30)")
            continue
        merged[key] = coerced
    if not merged.get("dest"):
        errors.append("library folder cannot be empty")
    return merged, errors


def _state_payload(cfg):
    p = paths_in_dest(cfg["dest"])
    state = {}
    try:
        with open(p["state"]) as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        pass
    hot = []
    channels = {}
    overrides = cfg.get("channel_budget_overrides") or {}
    try:
        channels = analyze(cfg, state.get("history") or [], now_utc())
        for ch in sorted((c for c in channels.values() if c.get("hot")),
                         key=lambda c: channel_budget(cfg, c), reverse=True):
            hot.append({
                "name": ch.get("name"),
                "key": ch.get("key"),
                "budget_gb": round(channel_budget(cfg, ch) / 1e9, 2),
                "distinct": ch.get("distinct"),
                "audio": _is_audio_channel(cfg, ch),
                "override": bool({ch.get("name"), ch.get("key"), ch.get("url")} & set(overrides)),
            })
    except Exception:
        pass
    usage = free_space(cfg)
    try:
        size_gb = round(library_size(cfg["dest"]) / 1e9, 1)
    except (OSError, KeyError, TypeError):
        size_gb = None
    return {
        "dest": cfg.get("dest"),
        "last_run": state.get("last_run"),
        "last_ingest": state.get("last_ingest"),
        "history": len(state.get("history") or []),
        "index": len(state.get("index") or {}),
        "channels": len(channels),
        "hot_count": len(hot),
        "size_gb": size_gb,
        "daemon": daemon_installed(),
        "daemon_next": daemon_next_run(),
        "ad_videos": len(state.get("ad_videos") or {}),
        "ad_channels": len(state.get("ad_landings") or {}),
        "ad_purged": len(state.get("ad_purged_channels") or []),
        "hot": hot,
        "free_gb": round(usage.free / 1e9, 1) if usage else None,
    }


class _SettingsHandler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _json(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _html(self, text):
        body = text.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        cfg = SELL.get("cfg") or {}
        if self.path in ("/", "/index.html"):
            self._html(SETTINGS_HTML.replace("__PORT__", str(cfg.get("settings_port", 8765))))
        elif self.path == "/api/schema":
            self._json(_schema_with_values(cfg))
        elif self.path == "/api/config":
            self._json(cfg)
        elif self.path == "/api/state":
            self._json(_state_payload(cfg))
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        cfg = SELL.get("cfg") or {}
        if self.path != "/api/config":
            self._json({"error": "not found"}, 404)
            return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            payload = json.loads((self.rfile.read(n) or b"{}").decode() or "{}")
        except (ValueError, json.JSONDecodeError):
            self._json({"error": "bad request body"}, 400)
            return
        merged, errors = _apply_config_update(cfg, payload)
        if errors:
            self._json({"error": "; ".join(errors)}, 400)
            return
        merged["dest"] = os.path.expanduser(merged["dest"])
        save_config(merged)
        SELL["cfg"] = merged
        self._json({"ok": True})


def serve_settings(cfg, silent=False):
    SELL["cfg"] = cfg
    port = int(cfg.get("settings_port", 8765))
    url = "http://127.0.0.1:%d" % port
    try:
        httpd = ThreadingHTTPServer(("127.0.0.1", port), _SettingsHandler)
    except OSError:
        log("could not bind %s — is a settings page already open?" % url, silent)
        return
    if not silent:
        log("settings page: %s  (Ctrl+C to stop)" % url)
    try:
        webbrowser.open(url)
    except Exception:
        pass
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()


